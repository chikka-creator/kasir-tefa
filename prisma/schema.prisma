generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  AUDIT
  TEACHER
  ADMIN
}

enum ItemType {
  SERVICE
  GOODS
}

enum ShiftStatus {
  OPEN
  PENDING_VERIFICATION
  VERIFIED_BY_TEACHER
  CLOSED_AUDITED
}

enum VarianceStatus {
  BALANCE
  MINUS
  PLUS
}

enum DeviceTerminal {
  POS_1
  POS_2
}

enum PaymentMethod {
  CASH
  QRIS
}

enum TransactionStatus {
  PAID
  VOID_REQUESTED
  VOIDED
}

enum VoidApprovalMethod {
  PIN_ON_SITE
  DASHBOARD_REMOTE
}

enum MovementType {
  INITIAL
  RESTOCK
  SALE
  VOID_RETURN
  SPOILAGE_DAMAGE
}

enum Severity {
  INFO
  WARNING
  CRITICAL
}

model User {
  id                  String   @id @default(uuid())
  username            String   @unique @db.VarChar(50)
  password_hash       String   @db.VarChar(255)
  full_name           String   @db.VarChar(100)
  role                Role
  supervisor_pin_hash String?  @db.VarChar(255)
  is_active           Boolean  @default(true)
  created_at          DateTime @default(now())
  updated_at          DateTime @default(now()) @updatedAt

  created_products    Product[]       @relation("ProductCreator")
  verified_shifts     Shift[]         @relation("ShiftVerifier")
  audited_shifts      Shift[]         @relation("ShiftAuditor")
  voided_transactions Transaction[]   @relation("VoidApprover")
  stock_movements     StockMovement[] @relation("StockMovementCreator")
  audit_logs          AuditLog[]      @relation("UserAuditLogs")

  @@map("users")
}

model Category {
  id         Int       @id @default(autoincrement())
  name       String    @db.VarChar(50)
  created_at DateTime  @default(now())
  products   Product[]

  @@map("categories")
}

model Product {
  id            String   @id @default(uuid())
  category_id   Int?
  sku           String   @unique @db.VarChar(50)
  name          String   @db.VarChar(150)
  item_type     ItemType
  cost_price    Decimal  @default(0) @db.Decimal(12, 2)
  selling_price Decimal  @db.Decimal(12, 2)
  stock_qty     Int?
  unit          String   @default("pcs") @db.VarChar(20)
  is_active     Boolean  @default(true)
  created_by    String?
  updated_at    DateTime @default(now()) @updatedAt

  category          Category?         @relation(fields: [category_id], references: [id], onDelete: SetNull)
  creator           User?             @relation("ProductCreator", fields: [created_by], references: [id], onDelete: SetNull)
  transaction_items TransactionItem[]
  stock_movements   StockMovement[]

  @@map("products")
}

model Shift {
  id                       String         @id @default(uuid())
  shift_code               String         @unique @db.VarChar(30)
  student_worker_1         String         @db.VarChar(100)
  student_worker_2         String         @db.VarChar(100)
  student_worker_3         String         @db.VarChar(100)
  student_supervisor       String         @db.VarChar(100)
  opened_at                DateTime       @default(now())
  closed_at                DateTime?
  status                   ShiftStatus    @default(OPEN)
  opening_cash             Decimal        @default(0) @db.Decimal(12, 2)
  expected_cash            Decimal?       @db.Decimal(12, 2)
  actual_cash_counted      Decimal?       @db.Decimal(12, 2)
  cash_variance            Decimal?       @db.Decimal(12, 2)
  variance_status          VarianceStatus?
  expected_qris            Decimal?       @db.Decimal(12, 2)
  actual_qris_counted      Decimal?       @db.Decimal(12, 2)
  closing_notes            String?        @db.Text
  verified_by              String?
  verified_at              DateTime?
  teacher_score            Int?
  teacher_evaluation_notes String?        @db.Text
  audited_by               String?
  audited_at               DateTime?

  verifier        User?           @relation("ShiftVerifier", fields: [verified_by], references: [id], onDelete: SetNull)
  auditor         User?           @relation("ShiftAuditor", fields: [audited_by], references: [id], onDelete: SetNull)
  transactions    Transaction[]
  stock_movements StockMovement[]
  audit_logs      AuditLog[]

  @@map("shifts")
}

model Transaction {
  id                   String              @id @default(uuid())
  invoice_number       String              @unique @db.VarChar(40)
  shift_id             String
  device_terminal      DeviceTerminal
  subtotal             Decimal             @db.Decimal(12, 2)
  total_amount         Decimal             @db.Decimal(12, 2)
  total_cost           Decimal             @db.Decimal(12, 2)
  payment_method       PaymentMethod
  cash_received        Decimal?            @db.Decimal(12, 2)
  cash_change          Decimal?            @db.Decimal(12, 2)
  qris_reference       String?             @db.VarChar(100)
  status               TransactionStatus   @default(PAID)
  void_reason          String?             @db.Text
  void_approval_method VoidApprovalMethod?
  void_approved_by     String?
  void_approved_at     DateTime?
  created_at           DateTime            @default(now())

  shift         Shift             @relation(fields: [shift_id], references: [id])
  void_approver User?             @relation("VoidApprover", fields: [void_approved_by], references: [id], onDelete: SetNull)
  items         TransactionItem[]

  @@map("transactions")
}

model TransactionItem {
  id                     String   @id @default(uuid())
  transaction_id         String
  product_id             String
  product_name_snapshot  String   @db.VarChar(150)
  item_type_snapshot     String   @db.VarChar(20)
  qty                    Int
  cost_price_snapshot    Decimal  @db.Decimal(12, 2)
  selling_price_snapshot Decimal  @db.Decimal(12, 2)
  subtotal               Decimal  @db.Decimal(12, 2)

  transaction Transaction @relation(fields: [transaction_id], references: [id], onDelete: Cascade)
  product     Product     @relation(fields: [product_id], references: [id])

  @@map("transaction_items")
}

model StockMovement {
  id              String       @id @default(uuid())
  product_id      String
  shift_id        String?
  movement_type   MovementType
  qty_change      Int
  stock_before    Int
  stock_after     Int
  reason_category String?      @db.VarChar(50)
  notes           String       @db.Text
  created_by      String
  created_at      DateTime     @default(now())

  product Product @relation(fields: [product_id], references: [id])
  shift   Shift?  @relation(fields: [shift_id], references: [id], onDelete: SetNull)
  creator User    @relation("StockMovementCreator", fields: [created_by], references: [id])

  @@map("stock_movements")
}

model AuditLog {
  id              String   @id @default(uuid())
  user_id         String
  user_role       String   @db.VarChar(20)
  shift_id        String?
  device_terminal String?  @db.VarChar(20)
  action_type     String   @db.VarChar(50)
  severity        Severity @default(INFO)
  entity_name     String   @db.VarChar(50)
  entity_id       String
  old_values      Json?
  new_values      Json?
  description     String   @db.Text
  created_at      DateTime @default(now())

  user  User   @relation("UserAuditLogs", fields: [user_id], references: [id])
  shift Shift? @relation(fields: [shift_id], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}
