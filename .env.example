# 1. Koneksi Database PostgreSQL
# Untuk migrasi & seed gunakan endpoint DIRECT (tanpa "-pooler").
# Untuk runtime Vercel (serverless) gunakan endpoint POOLER + parameter pgbouncer=true.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# 2. Rahasia Autentikasi & JWT Session (Minimal 32 karakter)
AUTH_SECRET="tefa-kasir-super-secret-key-32-chars-min-change-in-prod"
SESSION_MAX_AGE=86400

# 3. Pengaturan Identitas Sekolah & Struk Thermal
NEXT_PUBLIC_SCHOOL_NAME="SMK TEFA PERCETAKAN"
NEXT_PUBLIC_UNIT_NAME="Unit Produksi & Bisnis Percetakan Siswa"
NEXT_PUBLIC_RECEIPT_PAPER_SIZE="58mm"

# 4. Akun Default Seeder
# Password & PIN dikosongkan agar di-generate acak, lalu hanya ditampilkan di
# console saat akun benar-benar baru dibuat. Isi manual bila ingin tertentu.
INITIAL_AUDIT_USERNAME="audit_sekolah"
INITIAL_AUDIT_PASSWORD=""
INITIAL_TEACHER_USERNAME="guru_tefa"
INITIAL_TEACHER_PASSWORD=""
INITIAL_TEACHER_PIN=""
INITIAL_ADMIN_USERNAME="kasir_tefa"
INITIAL_ADMIN_PASSWORD=""
